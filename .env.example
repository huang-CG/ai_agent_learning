# 复制为 .env 并填入你的 Key（勿提交 .env）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Day31+ Embedding（硅基流动；DeepSeek 无 Embedding）
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Day39+ LangSmith tracing（https://smith.langchain.com 注册后填；勿提交真实 Key）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=ai-agent-quick-d39
